# -----------------------------------------------------------
# Gumeli Surgical - Supabase configuration
# Copy this file to ".env" and fill in your Supabase project keys.
#
# Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------

# Project URL (looks like https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (safe to expose in the frontend - RLS protects data)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# IMPORTANT:
# 1. Run supabase/schema.sql in the Supabase SQL Editor.
# 2. Create a public Storage bucket named "store-images".
# 3. Create your admin user under Authentication -> Users.
#
# If these variables are NOT set, the app automatically runs in
# DEMO MODE with sample medical products stored in this device only.
